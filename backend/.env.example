# Server
PORT=3000
NODE_ENV=development

# CORS: frontend dev origin (Vite default)
# Set to your frontend origin while developing, e.g. http://localhost:5173
CORS_ORIGIN=http://localhost:5173

# Database (MySQL) — replace placeholders with your DB credentials
# Format: mysql://USER:PASSWORD@HOST:PORT/DATABASE
# Example for local MySQL with user root and no password:
# DATABASE_URL="mysql://root:@localhost:3306/finalproject_db"
DATABASE_URL="mysql://<DB_USER>:<DB_PASSWORD>@<DB_HOST>:<DB_PORT>/<DB_NAME>"

# JWT secret (do NOT commit the real secret). Generate one for .env (see note below).
JWT_SECRET=<your_jwt_secret_here>

# Optional: default token expiry used by some endpoints (login uses 7d in code)
JWT_EXPIRES_IN=7d